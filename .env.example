# ===== यह फाइल copy करके .env नाम रखो, फिर अपनी values भरो =====

# Telegram bot ka token (@BotFather se milta hai)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Aapki khud ki Telegram user ID (@userinfobot se pata karo)
# (bot.py isi ko admin maan kar chalga)
ADMIN_IDS=123456789

# Wahi ID — fetch_news.py is par news bhejga
CHAT_ID=123456789

# Har tweet draft ke end me yeh hashtags lagenge
HASHTAGS="#TeamIndia #IndianCricket"

# News sources — default: SIRF Indian cricket (Team India + IPL + domestic)
# (comma se separate karke kitni bhi daal sakte ho)
RSS_URLS=https://news.google.com/rss/search?q=india+cricket+team+when:1d&hl=en-IN&gl=IN&ceid=IN:en,https://news.google.com/rss/search?q=IPL+when:2d&hl=en-IN&gl=IN&ceid=IN:en,https://news.google.com/rss/search?q=ranji+trophy+OR+duleep+trophy+OR+irani+trophy+OR+indian+domestic+cricket+when:3d&hl=en-IN&gl=IN&ceid=IN:en

# Ek run me max kitni news bheju (baaki skip, agli baar nahi repeat hongi)
MAX_PER_RUN=5
